<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="watch_faces_select_font_style" parent="@android:style/Widget.DeviceDefault.Light.TextView">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark_gray</item>
        <item name="android:shadowColor">@color/drop_shadow_text</item>
        <item name="android:shadowDx">1.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">1.0</item>
    </style>
    <style name="watch_faces_select_font_style_black" parent="@android:style/Widget.DeviceDefault.Light.TextView">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="delete_widget" parent="@style/watch_faces_select_style">
        <item name="android:textSize">22.0sp</item>
    </style>
    <style name="watch_faces_select_style" parent="@android:style/Widget.DeviceDefault.Light.TextView">
        <item name="android:background">@drawable/widget_clock_select_bkg</item>
        <item name="android:shadowColor">@color/drop_shadow_text</item>
        <item name="android:shadowDx">1.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">1.0</item>
    </style>
    <style name="Theme.NoBackground" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowBackground">@null</item>
    </style>
    <style name="Theme.Background" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:actionBarStyle">@style/TransparentActionBar</item>
        <item name="android:actionBarDivider">@android:color/transparent</item>
    </style>
    <style name="TransparentActionBar" parent="@android:style/Widget.DeviceDefault.Light.ActionBar.Solid">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundSplit">@android:color/transparent</item>
    </style>
</resources>
